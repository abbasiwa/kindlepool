# KindlePool Relayer Configuration

# Secret key for the fee-bump relayer account (must have XLM balance)
KINDPOOL_RELAYER_SECRET=

# Stellar RPC URL
KINDPOOL_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet or mainnet)
KINDPOOL_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Port
KINDPOOL_RELAYER_PORT=3002

# Rate limit per IP per minute
KINDPOOL_RELAYER_RATE_LIMIT=50
