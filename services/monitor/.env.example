# KindlePool Monitor Configuration

# Stellar RPC URL (default: testnet)
KINDPOOL_MONITOR_RPC=https://soroban-testnet.stellar.org

# Contract ID to monitor
KINDPOOL_CONTRACT_ID=

# Check interval in milliseconds (default: 300000 = 5 minutes)
KINDPOOL_MONITOR_INTERVAL=300000

# Anomaly threshold — deposits per minute to trigger alert
KINDPOOL_ANOMALY_THRESHOLD=10

# Slack/Teams webhook URL for critical alerts
KINDPOOL_ALERT_WEBHOOK=

# Data directory for health records
KINDPOOL_MONITOR_DATA=./data
